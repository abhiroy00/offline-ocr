# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database. Leave unset to use local SQLite (dev/test default).
# Example for Postgres: postgres://user:password@localhost:5432/ocr
DATABASE_URL=

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKERS=8

# OCR engine
OCR_ENGINE=PADDLEOCR
OCR_DEVICE=auto
OCR_CONFIDENCE_THRESHOLD=0.70
OCR_LANG=en
PDF_RENDER_DPI=300

# Uploads
MAX_UPLOAD_SIZE=26214400
MEDIA_ROOT=media
